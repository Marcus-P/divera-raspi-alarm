[Unit]
Description=DIVERA technical fault notification for %i
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=divera-alarm
Group=divera-alarm
Environment=DRA_CONFIG=/var/lib/divera-raspi-alarm/config.toml
LoadCredentialEncrypted=divera_access_key:/etc/credstore.encrypted/divera_access_key
WorkingDirectory=/opt/divera-raspi-alarm/current/app
ExecStart=/opt/divera-raspi-alarm/current/venv/bin/python -m divera_alarm.notify %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
