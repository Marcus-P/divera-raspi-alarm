[Unit]
Description=DIVERA Raspberry Alarm smoke alarm MQTT worker
After=network-online.target mosquitto.service
Requires=mosquitto.service
[Service]
Type=simple
User=divera-alarm
Group=divera-alarm
Environment=DRA_CONFIG=/var/lib/divera-raspi-alarm/config.toml
LoadCredentialEncrypted=divera_access_key:/etc/credstore.encrypted/divera_access_key
LoadCredentialEncrypted=divera_system_key:/etc/credstore.encrypted/divera_system_key
WorkingDirectory=/opt/divera-raspi-alarm/current/app
ExecStart=/opt/divera-raspi-alarm/current/venv/bin/python -m divera_alarm.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/divera-raspi-alarm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
[Install]
WantedBy=multi-user.target
