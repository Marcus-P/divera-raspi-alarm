[Unit]
Description=DIVERA Raspberry Alarm administration service
After=network.target
[Service]
Type=simple
User=divera-alarm
Group=divera-alarm
Environment=DRA_CONFIG=/var/lib/divera-raspi-alarm/config.toml
LoadCredentialEncrypted=divera_access_key:/etc/credstore.encrypted/divera_access_key
WorkingDirectory=/opt/divera-raspi-alarm/current/app
ExecStart=/opt/divera-raspi-alarm/current/venv/bin/uvicorn divera_alarm.main:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/divera-raspi-alarm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
[Install]
WantedBy=multi-user.target
